  "error_example": {
    "endpoint": "GET /api/products/search",
    "note": "Missing query parameter",
    "response": {
      "success": false,
      "message": "Search query is required",
      "data": []
    }
  },

  "usage_guide": {
    "javascript": {
      "search_samsung": "fetch('/api/products/search?q=samsung').then(r => r.json())",
      "search_iphone": "fetch('/api/products/search?q=iphone').then(r => r.json())",
      "search_gaming_laptop": "fetch('/api/products/search?q=gaming laptop').then(r => r.json())",
      "get_by_category": "fetch('/api/products/category/iPhone').then(r => r.json())",
      "get_all": "fetch('/api/products/all').then(r => r.json())"
    },
    "curl": {
      "search_samsung": "curl 'http://localhost:8000/api/products/search?q=samsung'",
      "search_iphone": "curl 'http://localhost:8000/api/products/search?q=iphone'",
      "search_gaming_laptop": "curl 'http://localhost:8000/api/products/search?q=gaming%20laptop'",
      "get_by_category": "curl 'http://localhost:8000/api/products/category/Samsung'",
      "get_all": "curl 'http://localhost:8000/api/products/all'"
    },
    "php": {
      "search": "Product::where('name', 'LIKE', '%samsung%')->orWhere('category', 'LIKE', '%samsung%')->with('prices.retailer')->get()",
      "by_category": "Product::where('category', 'Samsung')->with('prices.retailer')->get()",
      "all": "Product::with('prices.retailer')->get()"
    }
  },

  "response_fields": {
    "id": "Product ID in database",
    "name": "Product name from Shopee",
    "category": "Category: Samsung, iPhone, or Gaming Laptop",
    "image_url": "CDN URL to product image",
    "description": "Product description (nullable)",
    "price": "Price in RM (string with decimal places)",
    "product_url": "Direct link to Shopee product",
    "retailer": "Retailer name (Shopee Malaysia)",
    "scraped_at": "ISO timestamp when product was scraped",
    "count": "Total results matching query",
    "success": "Boolean indicating API success"
  }
}
